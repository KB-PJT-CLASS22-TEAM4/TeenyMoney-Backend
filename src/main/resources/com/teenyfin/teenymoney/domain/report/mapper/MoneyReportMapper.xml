<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.teenyfin.teenymoney.domain.report.mapper.MoneyReportMapper">

    <!--
        소비 집계 세 쿼리가 공유하는 FROM 절.

        w.type = 'MEMBER' 는 기존 PaymentMapper 패턴에 없는 조건을 더한 것이다.
        자녀는 MEMBER 지갑 외에 DEPOSIT·SAVING 지갑도 가지므로 지갑 종류를 좁히지 않으면
        소비가 아닌 행을 셀 여지가 남는다. sql/seed/03_validate_money_report_demo.sql 의
        검증 쿼리도 같은 필터를 건다.
    -->
    <sql id="spendingFrom">
        FROM T_PAY_TRAN_L p
        JOIN T_WLT_BASE_M w
        ON p.wallet_id = w.id
        AND w.type = 'MEMBER'
    </sql>

    <!--
        status = 'SUCCESS' 는 정의서 6.2의 중복 집계 방지다. 예금·적금 이체와 대출 상환은
        애초에 다른 테이블이라 자연히 빠진다.

        created_at 이 DATETIME 이므로 to 는 다음 날 자정 미만으로 비교한다.
        `<= #{to}` 로 두면 to 당일 00:00:00 이후의 결제가 통째로 빠진다.
    -->
    <sql id="spendingWhere">
        WHERE w.member_id = #{childId}
        AND p.status = 'SUCCESS'
        AND p.created_at &gt;= #{from}
        AND p.created_at &lt; DATE_ADD(#{to}, INTERVAL 1 DAY)
    </sql>

    <select id="selectChildProfile"
            resultType="com.teenyfin.teenymoney.domain.report.vo.ChildProfileVO">
        SELECT id,
               `role`,
               birth_date,
               created_at
        FROM T_MBR_INFO_M
        WHERE id = #{childId}
    </select>

    <select id="selectSpendingTotal"
            resultType="com.teenyfin.teenymoney.domain.report.vo.SpendingTotalVO">
        SELECT COALESCE(SUM(p.amount), 0) AS total_amount,
               COUNT(*)                   AS payment_count
        <include refid="spendingFrom"/>
        <include refid="spendingWhere"/>
    </select>

    <!--
        카테고리 이름은 LEFT JOIN + COALESCE 로 가져온다. category_id 는 현재 코드 경로상
        NULL 이 될 수 없지만(PaymentService 가 INVALID_MERCHANT_CODE 로 막는다),
        카테고리 마스터가 지워진 과거 결제가 이름 없이 내려가 화면이 비는 것을 막는다.

        applied_policy 를 GROUP BY 축에 두면 같은 결과를 두 가지로 접을 수 있다.
        카테고리 목록은 정책 무관 합산, 주의 업종 목록은 WATCH 행만 모은다.
        같은 카테고리가 정책별로 여러 줄이 될 수 있으므로 최종 정렬은 서비스에서 한 번 더 한다.
    -->
    <select id="selectSpendingByCategory"
            resultType="com.teenyfin.teenymoney.domain.report.vo.SpendingCategoryVO">
        SELECT p.category_id              AS category_id,
               COALESCE(c.name, '미분류')  AS category_name,
               p.applied_policy           AS applied_policy,
               COALESCE(SUM(p.amount), 0) AS amount,
               COUNT(*)                   AS payment_count
        <include refid="spendingFrom"/>
        LEFT JOIN T_MCC_CTGR_C c ON c.id = p.category_id
        <include refid="spendingWhere"/>
        GROUP BY p.category_id, c.name, p.applied_policy
        ORDER BY amount DESC, payment_count DESC, category_name ASC
    </select>

    <select id="selectDailySpending"
            resultType="com.teenyfin.teenymoney.domain.report.vo.DailySpendingVO">
        SELECT DATE(p.created_at)         AS spent_date,
               COALESCE(SUM(p.amount), 0) AS amount,
               COUNT(*)                   AS payment_count
        <include refid="spendingFrom"/>
        <include refid="spendingWhere"/>
        GROUP BY DATE(p.created_at)
        ORDER BY spent_date
    </select>

</mapper>
