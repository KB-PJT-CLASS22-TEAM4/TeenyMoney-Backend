<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.teenyfin.teenymoney.domain.wallet.mapper.WalletMapper">


    <!-- DB 컬럼명(스네이크케이스)을 WalletVO 필드명(카멜케이스)에 매핑 -->
    <resultMap id="walletResultMap" type="com.teenyfin.teenymoney.domain.wallet.vo.WalletVO">
        <id property="id" column="id"/>
        <result property="memberId" column="member_id"/>
        <result property="balance" column="balance"/>
        <result property="type" column="type"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <resultMap id="walletTransactionResultMap" type="com.teenyfin.teenymoney.domain.wallet.vo.WalletTransactionVO">
        <id property="id" column="id"/>
        <result property="direction" column="direction"/>
        <result property="amount" column="amount"/>
        <result property="balanceAfter" column="balance_after"/>
        <result property="description" column="description"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>



    <!-- memberId로 MEMBER 타입 지갑만 골라서 찾는다 (예금/적금 지갑은 제외) -->
    <select id="selectMemberWalletByMemberId" resultMap="walletResultMap">
        SELECT id, member_id, balance, type, updated_at
        FROM T_WLT_BASE_M
        WHERE member_id = #{memberId} AND type = 'MEMBER'
    </select>

    <!-- 특정 지갑의 최신 거래내역을 limit개만 가져온다.
           created_at이 같은 값끼리 있을 수 있어서(같은 초에 여러 건), id DESC를 보조 정렬로 추가해
           "가장 최근에 쓰인 행"이 확실히 앞에 오게 한다 -->
    <select id="selectRecentTransactions"  resultMap="walletTransactionResultMap">
        SELECT id, direction, amount, balance_after, description, created_at
        FROM T_WLT_HIST_H
        WHERE wallet_id= #{walletId}
        ORDER BY created_at DESC, id DESC
        LIMIT #{limit}
    </select>


    <!-- 거래내역 목록 조회. 화면의 종류(전체/입금/출금)/기간(1주~6개월)/정렬(최신순/과거순)
               버튼 3개 상태를 그대로 파라미터로 받아서 하나의 쿼리로 처리한다. -->

    <select id="selectTransactions" resultMap="walletTransactionResultMap">
        SELECT id, direction, amount, balance_after, description, created_at
        FROM T_WLT_HIST_H
        WHERE wallet_id = #{walletId} AND created_at &gt;= #{startDate}
        <!-- direction이 null이면(=전체 선택) 이 조건 자체가 SQL에서 통째로 빠진다 -->
        <if test="direction != null">
            AND direction = #{direction}
        </if>
        ORDER BY created_at
        <!-- sortOrder는 자바 enum 이름 문자열("ASC"/"DESC")이 그대로 넘어온다.
               ${}가 아니라 <choose>로 화이트리스트 분기하는 이유: ORDER BY 방향은
               #{}(값 바인딩)로 못 넣고 SQL 문자열 자체를 바꿔야 하는데, 그렇다고
               ${}로 사용자 입력을 그대로 SQL에 꽂으면 SQL 인젝션 위험이 생긴다.
               그래서 "ASC가 맞으면 ASC, 그 외엔 무조건 DESC"로 직접 분기해서 안전하게 처리한다. -->
        <choose>
            <when test="sortOrder == 'ASC'">ASC</when>
            <otherwise>DESC</otherwise>
        </choose>
        , id
        <choose>
            <when test="sortOrder == 'ASC'">ASC</when>
            <otherwise>DESC</otherwise>
        </choose>
    </select>



    <!-- 지갑을 잠근 채로 조회한다. 이 SELECT가 실행된 순간부터 트랜잭션이 끝날 때까지
        다른 트랜잭션이 이 지갑 행을 동시에 못 건드린다 (동시에 잔액 깎다가 꼬이는 걸 방지). -->
    <select id="selectWalletForUpdate" resultMap="walletResultMap">
        SELECT id, member_id, balance, type, updated_at
        FROM T_WLT_BASE_M
        WHERE id = #{walletId}
        FOR UPDATE
    </select>

    <!-- 잠근 지갑의 잔액을 새 값으로 갱신한다.
        잔액이 바뀌는 시점이니 updated_at도 같이 현재 시각으로 갱신한다
        (안 그러면 "잔액 마지막 갱신 시각"이 실제와 어긋나게 됨). -->
    <update id="updateBalance">
        UPDATE T_WLT_BASE_M
        SET balance = #{balance}, updated_at = NOW()
        WHERE id = #{walletId}
    </update>

    <!-- T_WLT_HIST_H(지갑 변경 내역) 원장에 한 줄을 새로 남긴다.
          payment_id/transfer_id/charge_id 중 refType과 일치하는 컬럼에만 refId를 넣고,
          나머지 둘은 NULL로 둔다 (셋 중 정확히 하나만 NOT NULL이어야 하는 DB 제약을 만족시키기 위함).
          이 프로젝트의 selectTransactions에서 sortOrder를 <choose>로 화이트리스트 분기했던 것과 같은 방식.
          created_at은 컬럼 목록에서 아예 뺐다 - DEFAULT CURRENT_TIMESTAMP가 INSERT 시점에 자동으로 채워준다
          (MemberMapper.xml의 기존 INSERT문들도 전부 이 방식). -->

    <insert id="insertWalletHistory">
        INSERT INTO T_WLT_HIST_H
            (wallet_id, payment_id, transfer_id, charge_id, direction, amount, balance_after, description)
        VALUES (#{walletId},
            <choose>
                <when test="refType == 'PAYMENT'">#{refId}</when>
                <otherwise>NULL</otherwise>
            </choose>,
            <choose>
                <when test="refType == 'TRANSFER'">#{refId}</when>
                <otherwise>NULL</otherwise>
            </choose>,
            <choose>
                <when test="refType == 'CHARGE'">#{refId}</when>
                <otherwise>NULL</otherwise>
            </choose>,
            #{direction}, #{amount}, #{balanceAfter}, #{description}
        )
    </insert>

    <!-- 새 지갑을 만든다. balance는 항상 호출하는 쪽(WalletService.createWallet)에서 0으로 채워 넘긴다.
          useGeneratedKeys="true" keyProperty="id": INSERT 후 DB가 만든 auto_increment id를
          파라미터로 넘긴 WalletVO 객체의 id 필드에 MyBatis가 자동으로 다시 채워 넣어준다. -->
    <insert id="insertWallet" parameterType="com.teenyfin.teenymoney.domain.wallet.vo.WalletVO" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO T_WLT_BASE_M (member_id, balance, type)
        VALUES (#{memberId}, #{balance}, #{type})
    </insert>

</mapper>